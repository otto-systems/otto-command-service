{
  "name": "update.history",
  "description": "Read OttoUpdate history entries.",
  "parameters": {
    "type": "object",
    "required": [],
    "additionalProperties": false,
    "properties": {
      "limit": { "type": "number", "default": 50, "minimum": 1 },
      "offset": { "type": "number", "default": 0, "minimum": 0 }
    }
  },
  "returnType": { "type": "object", "additionalProperties": true },
