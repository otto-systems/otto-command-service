    "required": ["id"],
    "additionalProperties": false,
    "properties": { "id": { "type": "string" } }
  },
  "returnType": {
    "type": ["object", "null"],
    "additionalProperties": true
  },
  "errorTypes": ["RegistryReadError"],
  "permissions": ["file:read"],
  "routing": {
