      "patch": { "type": "object", "additionalProperties": true },
      "tierList": { "type": "array", "items": { "type": "number" } },
      "addTier": { "type": "number" },
      "deleteTier": { "type": "number" },
      "moveTier": { "type": "number" },
      "toIndex": { "type": "number" },
      "fallbackTier": { "type": "number" }
