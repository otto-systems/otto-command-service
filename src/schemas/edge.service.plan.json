{
  "name": "edge.service.plan",
  "description": "Generate systemd and proxy plan for stable HTTPS edge runtime.",
  "parameters": {
    "type": "object",
    "required": [],
    "additionalProperties": false,
    "properties": {
      "host": { "type": "string" },
      "port": { "type": "number" },
      "certDir": { "type": "string" },
      "certBaseName": { "type": "string" },
      "upstreamHost": { "type": "string" },
      "upstreamPort": { "type": "number" }
    }
  },
  "returnType": {
    "type": "object",
    "required": ["service", "proxy"],
    "additionalProperties": true,
    "properties": {
      "service": { "type": "object" },
      "proxy": { "type": "object" }
    }
  },
  "errorTypes": ["EdgeServicePlanError"],
  "permissions": ["edge:write"],
  "routing": {
    "handlerModule": "edgeServicePlan.mjs",
    "handlerExport": "handle",
    "exposedAs": ["cli", "api"],
    "http": { "method": "POST", "path": "/v1/commands/edge/service/plan" },
    "cli": { "group": "edge", "command": "service plan" },
    "operationId": "edgeServicePlan"
  }
}
