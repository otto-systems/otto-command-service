{
  "name": "config.set",
  "description": "Mutate OttoUpdate server configuration.",
  "parameters": {
    "type": "object",
    "required": [],
    "additionalProperties": false,
    "properties": {
      "path": { "type": "string", "default": "./config/server.toml" },
      "bind": { "type": ["string", "null"] },
      "bearer_token": { "type": ["string", "null"] }
    }
  },
  "returnType": {
    "type": "object",
    "required": ["updatedPath", "bind", "bearer_token"],
    "additionalProperties": false,
    "properties": {
      "updatedPath": { "type": "string" },
      "bind": { "type": "string" },
      "bearer_token": { "type": ["string", "null"] }
    }
  },
  "errorTypes": ["ConfigWriteError", "ConfigParseError"],
  "permissions": ["config:write"],
  "routing": {
    "handlerModule": "configSet.mjs",
    "handlerExport": "handle",
    "exposedAs": ["cli", "api"],
    "http": { "method": "POST", "path": "/v1/commands/config/set" },
    "cli": { "group": "config", "command": "set" },
    "operationId": "configSet"
  }
}
