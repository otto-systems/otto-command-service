{
  "name": "update.repair.auto-update-script",
  "title": "Repair Auto-Update Script",
  "description": "Detects if /opt/otto-display-system/auto-update.sh is stale and regenerates it from the canonical template. Automatically called by preflight if staleness is detected.",
  "parameters": {
    "type": "object",
    "required": [],
    "additionalProperties": false,
    "properties": {
      "installRoot": {
        "type": "string",
        "description": "Root installation directory (default: /opt/otto-display-system)"
      },
      "force": {
        "type": "boolean",
        "description": "Force regeneration even if script appears healthy",
        "default": false
      }
    }
  },
  "returnType": {
    "type": "object",
    "additionalProperties": true
  },
  "errorTypes": ["UpdateRepairError"],
  "permissions": ["update:write"],
  "routing": {
    "handlerModule": "updateRepairAutoUpdateScript.mjs",
    "handlerExport": "default",
    "exposedAs": ["cli", "api"],
    "http": { "method": "POST", "path": "/v1/commands/update/repair-auto-update-script" },
    "cli": { "group": "update", "command": "repair-auto-update-script" },
    "operationId": "updateRepairAutoUpdateScript"
  }
}
