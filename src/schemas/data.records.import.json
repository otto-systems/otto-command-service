{
  "name": "data.records.import",
  "description": "Import records from deterministic JSON or JSONL payload text.",
  "parameters": {
    "type": "object",
    "required": ["body"],
    "additionalProperties": false,
    "properties": {
      "body": { "type": "string" },
      "format": { "type": "string", "enum": ["json", "jsonl"] }
    }
  },
  "returnType": {
    "type": "object",
    "required": ["records", "format", "count"],
    "additionalProperties": false,
    "properties": {
      "records": {
        "type": "array",
        "items": { "type": "object", "additionalProperties": true }
      },
      "format": { "type": "string" },
      "count": { "type": "number" }
    }
  },
  "errorTypes": ["DataRecordsImportError"],
  "permissions": ["data:read"],
  "routing": {
    "handlerModule": "dataRecordsImport.mjs",
    "handlerExport": "handle",
    "exposedAs": ["cli", "api"],
    "http": { "method": "POST", "path": "/v1/commands/data/records/import" },
    "cli": { "group": "data", "command": "records-import" },
    "operationId": "dataRecordsImport"
  }
}
