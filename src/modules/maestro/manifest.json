{
  "schemaVersion": "1.0.0",
  "moduleId": "maestro",
  "displayName": "Maestro",
  "version": "0.1.10",
  "runtime": "maestro",
  "entryPoint": "otto/modules/maestro/index.ts",
  "entryRoute": "/maestro/install-status",
  "uiContract": "otto/manifests/maestro-ui-contract.json",
  "registrationContract": "otto/manifests/maestro-module-registration.json",
  "commandServiceLayer": "otto-command-service",
  "ownsCommandSurface": false,
  "dependencies": [
    "otto-command-service",
    "otto-ui",
    "otto-systems/otto-kernel",
    "otto-systems/otto-server"
  ],
  "capabilities": [
    "maestro.install",
    "maestro.update",
    "maestro.repair",
    "maestro.uninstall",
    "maestro.workflow.builder",
    "maestro.runtime.monitor",
    "maestro.registry.search",
    "maestro.execution.timeline",
    "maestro.tracing",
    "maestro.diagnostics"
  ],
  "bootstrap": {
    "type": "manifest",
    "requiredFiles": [
      "otto/manifests/maestro-ui-contract.json",
      "otto/manifests/maestro-module-registration.json",
      "otto/manifests/maestro-feature-catalog.json",
      "otto/maestro-payload.json"
    ],
    "registersWith": "otto-command-service"
  }
}
